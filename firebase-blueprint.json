  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Platform administrator authorization registry"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles with isolated PII"
    },
    "/holdings/{holdingId}": {
      "schema": { "$ref": "#/entities/Holding" },
      "description": "Root holding group metadata and executive metrics"
    },
    "/holdings/{holdingId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/HoldingMember" },
      "description": "Holding RBAC member roster controlling subcollection access"
    },
    "/holdings/{holdingId}/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Subsidiary companies belonging to a holding group"
    },
    "/holdings/{holdingId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects belonging to a holding group and subsidiary company"
    },
    "/holdings/{holdingId}/purchaseOrders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Purchase orders and executive approval decisions"
    },
    "/holdings/{holdingId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable holding audit log entries"
    }
  }
}
